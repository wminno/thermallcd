[Unit]
Description=thermallcd - nvtop monitor on Thermalright Trofeo Vision 9.16" LCD
After=multi-user.target

[Service]
Type=simple
User=@USER@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @REPO@/thermallcd/monitor.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
