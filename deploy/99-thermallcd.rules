# Thermalright Trofeo Vision 9.16" LCD (Winbond USBDISPLAY 0416:5408)
# - world-readable/writable so the monitor service and interactive tests run unprivileged
# - starts thermallcd.service whenever the panel is plugged into ANY USB port
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0416", ATTR{idProduct}=="5408", \
    MODE="0666", TAG+="systemd", ENV{SYSTEMD_WANTS}+="thermallcd.service"
