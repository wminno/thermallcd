# third-party reference code (GPL upstreams, 436 MB) — vendored locally only
reference/
# local gstack scratch
.gstack/
# python
__pycache__/
*.pyc
# session artifacts
*.jpeg
*.png
# ...except intentional repo images (README design previews)
!docs/screenshots/*.png
tools/*.bin
# machine-specific / sensitive: never commit
*.local
.env
.env.*
*.key
*.pem
*.token
# runtime state: the auth token file is named `token` (no extension), plus
# token.claimed and layouts/ — all machine-local, none of it belongs in git
data/
secrets/
deploy/thermallcd.service
.gbrain-source
.gbrain-owner.json
